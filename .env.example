# Copy this file to .env and fill in your own values.
# .env is git-ignored, so your real keys never reach GitHub.

# Required: the LLM that powers all four agents
OPENAI_API_KEY=sk-your-key-here

# Optional: which OpenAI model the agents use
OPENAI_MODEL=gpt-5.4-mini

# Required for live web research (Market Researcher and Review Analyst).
# Free key with 2,500 searches at https://serper.dev
SERPER_API_KEY=your-serper-key-here

# CrewAI sends anonymous usage telemetry by default; LaunchScout turns it off.
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
CREWAI_TRACING_ENABLED=false
